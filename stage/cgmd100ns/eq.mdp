; ============================================================================
; CGMD-Engine / Martini 3 -- EQUILIBRATION (default 20 ns, position restrained)
; ============================================================================
integrator              = md
dt                      = 0.02
nsteps                  = 500000
comm-mode               = linear
nstcomm                 = 100
constraints             = none
continuation            = no
gen-vel                 = yes
gen-temp                = 310.0
gen-seed                = -1
define = -DPOSRES

; --- neighbour searching / non-bonded (Martini 3 defaults) ------------------
nstlist                 = 20
cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
pbc                     = xyz

coulombtype             = reaction-field
rcoulomb                = 1.1
epsilon_r               = 15
epsilon_rf             = 0
vdwtype                 = cutoff
vdw-modifier            = Potential-shift
rvdw                    = 1.1

; --- thermostat / barostat --------------------------------------------------
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = 310.0
pcoupl                  = c-rescale
pcoupltype              = semiisotropic
tau-p                   = 4.0
compressibility         = 3e-4 3e-4
ref-p                   = 1.0 1.0
refcoord-scaling        = com

; --- output ----------------------------------------------------------------
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstenergy               = 5000
nstlog                  = 5000
nstcalcenergy           = 100
nstxout-compressed      = 50000
compressed-x-grps       = System
