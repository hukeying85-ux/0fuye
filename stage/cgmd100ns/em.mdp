; ============================================================================
; CGMD-Engine / Martini 3 -- ENERGY MINIMISATION
; Generated by code/cgmd/cgmd/engine.py -- do not edit inside a run directory.
; ============================================================================
integrator              = steep
emtol                   = 10.0
emstep                  = 0.001
nsteps                  = 5000

; --- neighbour searching / non-bonded (Martini 3 defaults) ------------------
nstlist                 = 20
cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
pbc                     = xyz

coulombtype             = reaction-field
rcoulomb                = 1.1
epsilon_r               = 15
epsilon_rf             = 0
vdwtype                 = cutoff
vdw-modifier            = Potential-shift
rvdw                    = 1.1

; --- output ----------------------------------------------------------------
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstenergy               = 100
nstlog                  = 100
nstxout-compressed      = 0
